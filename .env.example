# Database Configuration
DATABASE_URL=postgresql+asyncpg://bloguser:blogpassword@localhost:5432/techblog
TEST_DATABASE_URL=postgresql+asyncpg://bloguser:blogpassword@localhost:5432/techblog_test
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=blogpassword
POSTGRES_DB=techblog
POSTGRES_TEST_DB=techblog_test

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Optional, leave empty for local

# LLM Configuration
LLM_MODEL_PATH=/mnt/storage/models/gemma2-9b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Backend Configuration
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3777,http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm,.mov
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.ogg
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx

# Frontend Configuration
VITE_API_URL=http://localhost:8777

# pgAdmin (Optional)
PGADMIN_DEFAULT_EMAIL=admin@techblog.com
PGADMIN_DEFAULT_PASSWORD=admin

# JWT (if using authentication)
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (Optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
